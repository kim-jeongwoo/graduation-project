# 서버 주소 — 각자 환경에 맞게 설정
# Production: https://api.vocal-fit.com
# LAN (같은 와이파이): http://<local-server-ip>:8000
# ngrok/Tunnel: https://xxxx.ngrok-free.app
# EAS remote build는 Expo dashboard/EAS env에 설정된 값을 사용합니다.
EXPO_PUBLIC_API_URL=https://api.vocal-fit.com

# mock 모드: true=오프라인 시연, false=실서버 연결
EXPO_PUBLIC_USE_MOCK=false

# 졸업작품 시연용 보조 기능: true일 때만 Home에 스피치 평가 웹 버튼 표시
# 학원 배포용/상용화 빌드에서는 false로 둡니다.
EXPO_PUBLIC_ENABLE_SPEECH_WEB=false
